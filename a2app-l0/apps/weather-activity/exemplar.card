# level: L0
# model: weather-activity
#
# "What should I DO in this weather?" — the composed app, as an L0 card.
#
# The parent version branched with `if a >= 18 && aqi < 100 && precip < 40 { … }
# else { … }`. L0 has neither conjunction nor `else`, and that is not a gap to
# work around: a pile of overlapping guards is how a card renders two verdicts at
# once. What it has instead is a DECISION TREE of complementary siblings — at
# every level the two `when`s partition the value, so exactly one leaf is reached
# and each verdict is written once, as a named view.

# ── sources ──────────────────────────────────────────────────────────────────
source place sys.geocode(name: state.city)
source now   sys.weather(lat: place.lat, lon: place.lon,
                         fields: [temp, feels, cond, precip, wind])
source air   sys.airquality(lat: place.lat, lon: place.lon)
# The two halves of the answer. Both are fetched whichever way the verdict goes:
# a source is a declaration, so which one is DISPLAYED is the tree's business and
# the fetches cost the same either way.
source parks   sys.places(lat: place.lat, lon: place.lon, category: "park",
                          count: 3, fields: [id, name, distance])
source views   sys.places(lat: place.lat, lon: place.lon, category: "viewpoint",
                          count: 2, fields: [id, name, distance])
source museums sys.places(lat: place.lat, lon: place.lon, category: "museum",
                          count: 3, fields: [id, name, distance])
source cafes   sys.places(lat: place.lat, lon: place.lon, category: "cafe",
                          count: 2, fields: [id, name, distance])
# The page is a photograph of the place, as in the parent weather card — which is
# also why this card declares `theme photo` when a request asks for that look.
source scene sys.photo(query: place.name)
source env.locale sys.locale()

# ── state ────────────────────────────────────────────────────────────────────
state city  { shape: text, initial: "" }   # "" ⇒ the device's own location
state units { shape: enum[c, f], initial: env.locale.temp_unit }

event toggle_units { units: cycle(.c, .f) }

# ── copy ─────────────────────────────────────────────────────────────────────
copy eyebrow  { class: vocabulary, en: "TODAY", zh: "今天" }
copy loading  { class: vocabulary, en: "Reading the conditions…", zh: "正在读取天气…" }
copy offline  { class: vocabulary, en: "Can't reach the forecast", zh: "无法获取天气" }
copy go_out   { class: vocabulary, en: "Good day to be outside", zh: "适合外出" }
copy stay_in  { class: vocabulary, en: "Better indoors today", zh: "今天更适合室内" }
copy why_wet  { class: vocabulary, en: "rain is likely", zh: "可能有雨" }
copy why_air  { class: vocabulary, en: "the air is poor", zh: "空气质量差" }
copy why_cold { class: vocabulary, en: "it is cold out", zh: "天气偏冷" }
copy why_fine { class: vocabulary, en: "mild, dry and clear", zh: "温和、干燥、空气好" }
copy aqi_lbl  { class: vocabulary, en: "AIR", zh: "空气" }
copy rain_lbl { class: vocabulary, en: "RAIN", zh: "降水" }
copy near     { class: vocabulary, en: "away", zh: "距离" }

# ── view ─────────────────────────────────────────────────────────────────────
view root Photo(src: scene, pad: .page) {
       when now.$state == .pending { TextBody(text: copy.loading) }
       when now.$state == .failed  { TextBody(text: copy.offline) }
       current
       verdict
     }

# The parent's CURRENT block, in roles. The temperature is a value with a unit,
# not a string with a degree sign glued on.
view current Col(gap: 4) {
       TextCaption(text: copy.eyebrow)
       TextTitle(text: place.name, width: .fill)
       Row(align: .center, gap: 12, on_tap: toggle_units) {
         WeatherIcon(cond: now.cond, size: .hero)
         TextHero(value: now.temp, unit: units)
       }
       Row(gap: 14) {
         Tile(label: copy.rain_lbl, value: now.precip, unit: .pct)
         Tile(label: copy.aqi_lbl, value: air.aqi)
       }
     }

# ── the decision ─────────────────────────────────────────────────────────────
# Read top to bottom: each pair of `when`s splits one number, and the second of
# the pair is the first's exact complement. Nothing overlaps, so nothing renders
# twice, and there is no case with no answer.
#
# The ORDER is the reasoning: rain rules the day out first, then the air, then
# the temperature. A tree makes that order visible, which a conjunction did not.
view verdict Col(gap: 10) {
       when now.precip >= 40 { wet }
       when now.precip < 40 {
         when air.aqi >= 100 { smoggy }
         when air.aqi < 100 {
           when now.temp < 12 { cold }
           when now.temp >= 12 { fine }
         }
       }
     }

view wet    Col(gap: 10) { TextTitle(text: copy.stay_in)
                           TextBody(text: copy.why_wet)
                           indoors }
view smoggy Col(gap: 10) { TextTitle(text: copy.stay_in)
                           TextBody(text: copy.why_air)
                           indoors }
view cold   Col(gap: 10) { TextTitle(text: copy.stay_in)
                           TextBody(text: copy.why_cold)
                           indoors }
view fine   Col(gap: 10) { TextTitle(text: copy.go_out)
                           TextBody(text: copy.why_fine)
                           outdoors }

# ── the two answers ──────────────────────────────────────────────────────────
view outdoors Panel {
       when parks.$state == .pending { TextBody(text: copy.loading) }
       for p, i in parks key p.id {
         Row(align: .center, gap: 10) {
           Col(gap: 2, width: .fill) {
             TextRow(text: p.name)
             TextCaption(text: p.distance, suffix: copy.near)
           }
         }
         Rule()
       }
       for v, i in views key v.id {
         Row(align: .center, gap: 10) {
           Col(gap: 2, width: .fill) {
             TextRow(text: v.name)
             TextCaption(text: v.distance, suffix: copy.near)
           }
         }
         Rule()
       }
     }

view indoors Panel {
       when museums.$state == .pending { TextBody(text: copy.loading) }
       for m, i in museums key m.id {
         Row(align: .center, gap: 10) {
           Col(gap: 2, width: .fill) {
             TextRow(text: m.name)
             TextCaption(text: m.distance, suffix: copy.near)
           }
         }
         Rule()
       }
       for c, i in cafes key c.id {
         Row(align: .center, gap: 10) {
           Col(gap: 2, width: .fill) {
             TextRow(text: c.name)
             TextCaption(text: c.distance, suffix: copy.near)
           }
         }
         Rule()
       }
     }
