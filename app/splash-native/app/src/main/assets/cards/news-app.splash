// name: plain-card
// LOWERED from a semantic plan for the plain-data backend.
{t: "col", pad: 18, spacing: 12, c: [
    {t: "col", spacing: 2, c: [
        {t: "text", text: "HACKER NEWS", variant: "labelMedium"},
        {t: "text", text: "Top Stories", variant: "displayMedium"}
    ]},
    {t: "card", variant: "filled", pad: 14, c: [
        {t: "col", spacing: 6, c: [
            {t: "text", text: "LEAD", variant: "labelMedium"},
            {t: "text", text: sys.news(0, "title"), variant: "titleMedium"},
            {t: "text", text: sys.news(0, "points") + " pts" + " · " + sys.news(0, "author"), variant: "labelMedium"}
        ]}
    ]},
    {t: "text", text: "LATEST", variant: "labelMedium"},
    {t: "card", variant: "filled", pad: 14, c: [
        {t: "col", spacing: 6, c: [
            {t: "row", spacing: 10, c: [
                {t: "text", text: "1", variant: "bodyLarge", w: 26},
                {t: "col", spacing: 2, c: [
                    {t: "text", text: sys.news(1, "title"), variant: "bodyLarge"},
                    {t: "text", text: sys.news(1, "points") + " pts" + " · " + sys.news(1, "author"), variant: "labelMedium"}
                ]}
            ]},
            {t: "row", spacing: 10, c: [
                {t: "text", text: "2", variant: "bodyLarge", w: 26},
                {t: "col", spacing: 2, c: [
                    {t: "text", text: sys.news(2, "title"), variant: "bodyLarge"},
                    {t: "text", text: sys.news(2, "points") + " pts" + " · " + sys.news(2, "author"), variant: "labelMedium"}
                ]}
            ]},
            {t: "row", spacing: 10, c: [
                {t: "text", text: "3", variant: "bodyLarge", w: 26},
                {t: "col", spacing: 2, c: [
                    {t: "text", text: sys.news(3, "title"), variant: "bodyLarge"},
                    {t: "text", text: sys.news(3, "points") + " pts" + " · " + sys.news(3, "author"), variant: "labelMedium"}
                ]}
            ]},
            {t: "row", spacing: 10, c: [
                {t: "text", text: "4", variant: "bodyLarge", w: 26},
                {t: "col", spacing: 2, c: [
                    {t: "text", text: sys.news(4, "title"), variant: "bodyLarge"},
                    {t: "text", text: sys.news(4, "points") + " pts" + " · " + sys.news(4, "author"), variant: "labelMedium"}
                ]}
            ]},
            {t: "row", spacing: 10, c: [
                {t: "text", text: "5", variant: "bodyLarge", w: 26},
                {t: "col", spacing: 2, c: [
                    {t: "text", text: sys.news(5, "title"), variant: "bodyLarge"},
                    {t: "text", text: sys.news(5, "points") + " pts" + " · " + sys.news(5, "author"), variant: "labelMedium"}
                ]}
            ]},
            {t: "row", spacing: 10, c: [
                {t: "text", text: "6", variant: "bodyLarge", w: 26},
                {t: "col", spacing: 2, c: [
                    {t: "text", text: sys.news(6, "title"), variant: "bodyLarge"},
                    {t: "text", text: sys.news(6, "points") + " pts" + " · " + sys.news(6, "author"), variant: "labelMedium"}
                ]}
            ]}
        ]}
    ]}
]}
