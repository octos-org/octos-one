# level: L0
# model: travel-warsaw

source place sys.geocode(name: state.city)
source now   sys.weather(lat: place.lat, lon: place.lon,
                         fields: [temp, feels, cond, precip, wind, humidity, pressure, uv])
source week  sys.weather(lat: place.lat, lon: place.lon, days: 3,
                         fields: [dayname, hi, lo, cond],
                         aggregate: [min_lo, max_hi])
source sun   sys.daylight(lat: place.lat, lon: place.lon)
source moon  sys.moonphase()
source scene sys.photo(query: state.mood, cond: now.cond)
source out1  sys.search(query: "Royal Castle Warsaw", count: 1, fields: [name, label])
source out2  sys.search(query: "Old Town Market Square Warsaw", count: 1, fields: [name, label])
source out3  sys.search(query: "Vistula River Warsaw", count: 1, fields: [name, label])
source in1   sys.search(query: "Warsaw Uprising Museum", count: 1, fields: [name, label])
source in2   sys.search(query: "National Museum Warsaw", count: 1, fields: [name, label])
source in3   sys.search(query: "Łazienki Park Warsaw", count: 1, fields: [name, label])
source env.locale sys.locale()

state city  { shape: text, initial: "Warsaw" }
state units { shape: enum[c, f], initial: env.locale.temp_unit }
state mood  { shape: text, initial: "european city street with historic buildings, cinematic, muted" }

event toggle_units { units: cycle(.c, .f) }

copy eyebrow  { class: vocabulary, en: "WARSAW", zh: "华沙" }
copy loading  { class: vocabulary, en: "Reading the conditions…", zh: "正在读取天气…" }
copy offline  { class: vocabulary, en: "Can't reach the forecast", zh: "无法获取天气" }
copy go_out   { class: vocabulary, en: "Good day to be outside", zh: "适合外出" }
copy stay_in  { class: vocabulary, en: "Better indoors today", zh: "今天更适合室内" }
copy why_wet  { class: vocabulary, en: "rain is likely", zh: "可能有雨" }
copy why_cold { class: vocabulary, en: "it is cold out", zh: "天气偏冷" }
copy why_fine { class: vocabulary, en: "mild and dry", zh: "温和干燥" }
copy rain_lbl { class: vocabulary, en: "RAIN", zh: "降水" }
copy feels    { class: vocabulary, en: "Feels like", zh: "体感" }
copy humidity { class: vocabulary, en: "Humidity", zh: "湿度" }
copy wind     { class: vocabulary, en: "Wind", zh: "风速" }
copy pressure { class: vocabulary, en: "Pressure", zh: "气压" }
copy uv       { class: vocabulary, en: "UV Index", zh: "紫外线" }
copy precip   { class: vocabulary, en: "Rain", zh: "降水概率" }
copy sunrise  { class: vocabulary, en: "Sunrise", zh: "日出" }
copy sunset   { class: vocabulary, en: "Sunset", zh: "日落" }
copy things   { class: vocabulary, en: "Top Things to Do", zh: "推荐活动" }
copy around   { class: vocabulary, en: "Getting Around", zh: "出行方式" }
copy walk     { class: vocabulary, en: "Walk", zh: "步行" }
copy bike     { class: vocabulary, en: "Bike", zh: "骑行" }
copy transit  { class: vocabulary, en: "Transit", zh: "公共交通" }
copy tip_walk { class: vocabulary, en: "Old Town is best explored on foot", zh: "老城区适合步行" }
copy tip_bike { class: vocabulary, en: "Riverside paths are great for cycling", zh: "河畔步道适合骑行" }
copy tip_transit { class: vocabulary, en: "Metro and trams cover the city", zh: "地铁和电车覆盖全城" }

component Pick(hit: record) {
  view Col(gap: 2, width: .fill) {
         TextRow(text: hit.name)
         TextCaption(text: hit.label)
       }
}

view root Photo(src: scene, pad: .page) {
  when now.$state == .pending { TextBody(text: copy.loading) }
  when now.$state == .failed  { TextBody(text: copy.offline) }
  current
  forecast
  sunmoon
  details
  verdict
  around
}

view current Col(align: .center) {
  TextCaption(text: copy.eyebrow)
  TextTitle(text: place.name, width: .fill)
  WeatherIcon(cond: now.cond, size: .hero)
  TextHero(value: now.temp, unit: units, on_tap: toggle_units)
  Row(gap: 8, width: .fit) {
    TextCaption(glyph: "↑", value: now.hi, unit: units)
    TextCaption(glyph: "↓", value: now.lo, unit: units)
    TextCaption(glyph: "≈", value: now.feels, unit: units)
  }
}

component ForecastRow(item: record, unit: enum[c, f]) {
  view Row(align: .center) {
    TextRow(text: item.dayname, width: .day)
    WeatherIcon(cond: item.cond, size: .row)
    TextValue(value: item.lo, unit: unit)
    TempBar(lo: item.lo, hi: item.hi, min: week.min_lo, max: week.max_hi)
    TextValue(value: item.hi, unit: unit)
  }
}

view forecast Panel {
  for d in week.days key d.dayname {
    ForecastRow(item: d, unit: units)
  }
}

view sunmoon Panel {
  Row {
    Col { TextCaption(text: copy.sunrise) TextStat(value: sun.rise, format: .time) }
    SunArc(rise: sun.rise, set: sun.set, now: sun.now)
    Col { TextCaption(text: copy.sunset) TextStat(value: sun.set, format: .time) }
  }
  MoonPhase(phase: moon.phase, illum: moon.illumination)
}

view details Grid(cols: 2) {
  Tile(label: copy.feels, value: now.feels, unit: units)
  Tile(label: copy.humidity, value: now.humidity, unit: .pct)
  Tile(label: copy.wind, value: now.wind, unit: .speed)
  Tile(label: copy.pressure, value: now.pressure, unit: .pressure)
  Tile(label: copy.uv, value: now.uv)
  Tile(label: copy.precip, value: now.precip, unit: .pct)
}

view verdict Col(gap: 10) {
  when now.precip >= 40 { wet }
  when now.precip < 40 {
    when now.temp < 12 { cold }
    when now.temp >= 12 { fine }
  }
}

view wet Col(gap: 10) {
  TextTitle(text: copy.stay_in)
  TextBody(text: copy.why_wet)
  indoors
}

view cold Col(gap: 10) {
  TextTitle(text: copy.stay_in)
  TextBody(text: copy.why_cold)
  indoors
}

view fine Col(gap: 10) {
  TextTitle(text: copy.go_out)
  TextBody(text: copy.why_fine)
  outdoors
}

view outdoors Panel {
  when out1.$state == .pending { TextBody(text: copy.loading) }
  for h, i in out1 key h.label { Pick(hit: h) Rule() }
  for h, i in out2 key h.label { Pick(hit: h) Rule() }
  for h, i in out3 key h.label { Pick(hit: h) Rule() }
}

view indoors Panel {
  when in1.$state == .pending { TextBody(text: copy.loading) }
  for h, i in in1 key h.label { Pick(hit: h) Rule() }
  for h, i in in2 key h.label { Pick(hit: h) Rule() }
  for h, i in in3 key h.label { Pick(hit: h) Rule() }
}

view around Panel {
  TextTitle(text: copy.around)
  Row(align: .center, gap: 10) {
    TextRow(text: "🚶")
    Col(gap: 2, width: .fill) {
      TextRow(text: copy.walk)
      TextCaption(text: copy.tip_walk)
    }
  }
  Rule()
  Row(align: .center, gap: 10) {
    TextRow(text: "🚲")
    Col(gap: 2, width: .fill) {
      TextRow(text: copy.bike)
      TextCaption(text: copy.tip_bike)
    }
  }
  Rule()
  Row(align: .center, gap: 10) {
    TextRow(text: "🚇")
    Col(gap: 2, width: .fill) {
      TextRow(text: copy.transit)
      TextCaption(text: copy.tip_transit)
    }
  }
}
