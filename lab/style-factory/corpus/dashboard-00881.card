# level: L0
# model: weather-nav

source place    sys.geocode(name: state.city)
source now      sys.weather(lat: place.lat, lon: place.lon,
                            fields: [temp, feels, cond, precip, wind])
source scene    sys.photo(query: state.mood, cond: now.cond)

source here     sys.gps()
source found    sys.search(query: state.query, count: 5, fields: [name, label, query, lat, lon])
source dest     sys.search(query: state.dest, count: 1, fields: [id, name, lat, lon])
source trip     sys.route(from_lat: here.lat, from_lon: here.lon,
                          to_lat: dest.0.lat, to_lon: dest.0.lon,
                          mode: state.mode, fields: [duration, distance])
source step     sys.step(from_lat: here.lat, from_lon: here.lon,
                         to_lat: dest.0.lat, to_lon: dest.0.lon,
                         at_lat: here.lat, at_lon: here.lon,
                         fields: [instruction, remaining, eta])
source env.locale sys.locale()

state city  { shape: text, initial: "" }
state mood  { shape: text, initial: "city street commute morning, cinematic, muted" }
state units { shape: enum[c, f], initial: env.locale.temp_unit }
state dest  { shape: text, initial: "office" }
state query { shape: text, initial: "" }
state mode  { shape: enum[drive, walk, bike], initial: .drive }
state screen { shape: enum[plan, drive], initial: .plan }

event toggle_units { units: cycle(.c, .f) }
event pick_mode    { mode: set($value) }
event go           { screen: cycle(.plan, .drive) }
event edit_dest    { query: clear }
event typing       { query: set($value) }
event set_dest     { dest: set($value), query: clear }
event choose_dest  { dest: set($value), query: clear }

copy eyebrow   { class: vocabulary, en: "TODAY", zh: "今天" }
copy commute   { class: vocabulary, en: "Commute", zh: "通勤" }
copy loading   { class: vocabulary, en: "Getting the weather…", zh: "正在获取天气…" }
copy offline   { class: vocabulary, en: "Can't reach the weather service", zh: "无法获取天气" }
copy seeking   { class: vocabulary, en: "Finding a route…", zh: "正在查找路线…" }
copy to_office { class: vocabulary, en: "To office", zh: "去办公室" }
copy drive     { class: vocabulary, en: "Drive", zh: "驾车" }
copy walk      { class: vocabulary, en: "Walk", zh: "步行" }
copy bike      { class: vocabulary, en: "Bike", zh: "骑行" }
copy go_lbl    { class: vocabulary, en: "Go", zh: "出发" }
copy end_lbl   { class: vocabulary, en: "End", zh: "结束" }
copy away      { class: vocabulary, en: "away", zh: "距离" }

view root Photo(src: scene, pad: .page) {
  when now.$state == .pending { TextBody(text: copy.loading) }
  when now.$state == .failed  { TextBody(text: copy.offline) }
  current
  commute
}

view current Col(align: .center) {
  TextCaption(text: copy.eyebrow)
  TextTitle(text: place.name, width: .fill)
  Row(align: .center, gap: 12, on_tap: toggle_units) {
    WeatherIcon(cond: now.cond, size: .hero)
    TextHero(value: now.temp, unit: units)
  }
  Row(gap: 8, width: .fit) {
    TextCaption(glyph: "≈", value: now.feels, unit: units)
    TextCaption(glyph: "💧", value: now.precip, unit: .pct)
    TextCaption(glyph: "🌬", value: now.wind, unit: .speed)
  }
}

view commute Col {
  TextTitle(text: copy.commute, width: .fill)
  Row(align: .center, gap: 8) {
    TextCaption(text: copy.to_office, width: .fill)
    Row(align: .center, gap: 6, width: .fit) {
      Chip(text: copy.drive, on_tap: pick_mode, value: .drive, active: mode == .drive)
      Chip(text: copy.walk,  on_tap: pick_mode, value: .walk,  active: mode == .walk)
      Chip(text: copy.bike,  on_tap: pick_mode, value: .bike,  active: mode == .bike)
    }
  }

  when screen == .plan {
    when dest == "" {
      Row(align: .center, gap: 10, on_tap: edit_dest, value: "1") {
        TextCaption(text: copy.to_office, width: .label)
        TextRow(text: "Select destination", width: .fill)
      }
    }
    when dest != "" {
      Row(align: .center, gap: 10, on_tap: edit_dest, value: "1") {
        TextCaption(text: copy.to_office, width: .label)
        TextRow(text: dest, width: .fill)
      }
    }

    when query != "" {
      for f, i in found key f.label {
        Row(align: .center, gap: 10, on_tap: choose_dest, value: f.query) {
          Col(gap: 2, width: .fill) {
            TextRow(text: f.name)
            TextCaption(text: f.label)
          }
        }
      }
    }

    when dest != "" {
      when trip.$state == .pending { TextBody(text: copy.seeking) }
      when trip.$state == .ready {
        Row(align: .center, gap: 12) {
          TextValue(value: trip.duration, unit: .duration)
          TextCaption(value: trip.distance, suffix: copy.away)
          Chip(text: copy.go_lbl, on_tap: go, tone: .primary)
        }
        Map(mode: .plan, from_lat: here.lat, from_lon: here.lon, to: dest, zoom: 16)
      }
    }
  }

  when screen == .drive {
    Panel(dock: .top) {
      TextBody(text: step.instruction, width: .fill)
    }
    Panel(dock: .bottom) {
      TextHero(value: step.eta, unit: .duration)
      TextCaption(value: step.remaining)
      Chip(text: copy.end_lbl, on_tap: go, tone: .danger)
    }
    Map(mode: .drive, from_lat: here.lat, from_lon: here.lon, to: dest, at: here, zoom: 15)
  }
}
