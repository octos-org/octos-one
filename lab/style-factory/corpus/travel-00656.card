# level: L0
# model: travel-graz

source place sys.geocode(name: state.city)
source now   sys.weather(lat: place.lat, lon: place.lon,
                         fields: [temp, feels, cond, precip, wind, humidity, pressure, uv])
source scene sys.photo(query: state.mood, cond: now.cond)
source out1  sys.search(query: "Schlossberg Graz", count: 1, fields: [name, label])
source out2  sys.search(query: "Graz Old Town", count: 1, fields: [name, label])
source out3  sys.search(query: "Murinsel Graz", count: 1, fields: [name, label])
source in1   sys.search(query: "Kunsthaus Graz", count: 1, fields: [name, label])
source in2   sys.search(query: "Landesmuseum Joanneum Graz", count: 1, fields: [name, label])
source in3   sys.search(query: "Graz University", count: 1, fields: [name, label])
source env.locale sys.locale()

state city  { shape: text, initial: "Graz" }
state units { shape: enum[c, f], initial: env.locale.temp_unit }
state mood  { shape: text, initial: "historic city center with river and hills, cinematic, muted" }

event toggle_units { units: cycle(.c, .f) }

copy eyebrow  { class: vocabulary, en: "GRAZ TRAVEL", zh: "格拉茨旅行" }
copy loading  { class: vocabulary, en: "Reading the conditions…", zh: "正在读取天气…" }
copy offline  { class: vocabulary, en: "Can't reach the forecast", zh: "无法获取天气" }
copy go_out   { class: vocabulary, en: "Good day to be outside", zh: "适合外出" }
copy stay_in  { class: vocabulary, en: "Better indoors today", zh: "今天更适合室内" }
copy why_wet  { class: vocabulary, en: "rain is likely", zh: "可能有雨" }
copy why_cold { class: vocabulary, en: "it is cold out", zh: "天气偏冷" }
copy why_fine { class: vocabulary, en: "mild and dry", zh: "温和干燥" }
copy rain_lbl { class: vocabulary, en: "RAIN", zh: "降水" }
copy feels    { class: vocabulary, en: "Feels like", zh: "体感" }
copy humidity { class: vocabulary, en: "Humidity", zh: "湿度" }
copy wind     { class: vocabulary, en: "Wind", zh: "风速" }
copy pressure { class: vocabulary, en: "Pressure", zh: "气压" }
copy uv       { class: vocabulary, en: "UV Index", zh: "紫外线" }
copy around   { class: vocabulary, en: "Getting Around", zh: "如何出行" }
copy walk     { class: vocabulary, en: "Walk", zh: "步行" }
copy bike     { class: vocabulary, en: "Bike", zh: "骑行" }
copy transit  { class: vocabulary, en: "Transit", zh: "公共交通" }
copy tip_walk { class: vocabulary, en: "The old town is compact and best explored on foot.", zh: "老城区紧凑，最适合步行探索。" }
copy tip_bike { class: vocabulary, en: "Use bike lanes along the Mur for a scenic ride.", zh: "沿穆尔河骑行道欣赏风景。" }
copy tip_transit { class: vocabulary, en: "Trams connect the center to the university and museums.", zh: "有轨电车连接市中心、大学和博物馆。" }

component Pick(hit: record) {
  view Col(gap: 2, width: .fill) {
    TextRow(text: hit.name)
    TextCaption(text: hit.label)
  }
}

view root Photo(src: scene, pad: .page) {
  when now.$state == .pending { TextBody(text: copy.loading) }
  when now.$state == .failed  { TextBody(text: copy.offline) }
  current
  verdict
  around
}

view current Col(gap: 4) {
  TextCaption(text: copy.eyebrow)
  TextTitle(text: place.name, width: .fill)
  Row(align: .center, gap: 12, on_tap: toggle_units) {
    WeatherIcon(cond: now.cond, size: .hero)
    TextHero(value: now.temp, unit: units)
  }
  Row(gap: 14) {
    Tile(label: copy.rain_lbl, value: now.precip, unit: .pct)
    Tile(label: copy.feels, value: now.feels, unit: units)
  }
  Grid(cols: 2) {
    Tile(label: copy.humidity, value: now.humidity, unit: .pct)
    Tile(label: copy.wind, value: now.wind, unit: .speed)
    Tile(label: copy.pressure, value: now.pressure, unit: .pressure)
    Tile(label: copy.uv, value: now.uv)
  }
}

view verdict Col(gap: 10) {
  when now.precip >= 40 { wet }
  when now.precip < 40 {
    when now.temp < 12 { cold }
    when now.temp >= 12 { fine }
  }
}

view wet Col(gap: 10) {
  TextTitle(text: copy.stay_in)
  TextBody(text: copy.why_wet)
  indoors
}

view cold Col(gap: 10) {
  TextTitle(text: copy.stay_in)
  TextBody(text: copy.why_cold)
  indoors
}

view fine Col(gap: 10) {
  TextTitle(text: copy.go_out)
  TextBody(text: copy.why_fine)
  outdoors
}

view outdoors Panel {
  when out1.$state == .pending { TextBody(text: copy.loading) }
  for h, i in out1 key h.label { Pick(hit: h) Rule() }
  for h, i in out2 key h.label { Pick(hit: h) Rule() }
  for h, i in out3 key h.label { Pick(hit: h) Rule() }
}

view indoors Panel {
  when in1.$state == .pending { TextBody(text: copy.loading) }
  for h, i in in1 key h.label { Pick(hit: h) Rule() }
  for h, i in in2 key h.label { Pick(hit: h) Rule() }
  for h, i in in3 key h.label { Pick(hit: h) Rule() }
}

view around Panel {
  TextTitle(text: copy.around)
  Row(gap: 8) {
    Chip(text: copy.walk, tone: .primary)
    Chip(text: copy.bike)
    Chip(text: copy.transit)
  }
  TextBody(text: copy.tip_walk)
  TextBody(text: copy.tip_bike)
  TextBody(text: copy.tip_transit)
}
