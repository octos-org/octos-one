# level: L0
# model: weather-nav

source place sys.geocode(name: state.city)
source now   sys.weather(lat: place.lat, lon: place.lon,
                         fields: [temp, feels, cond, precip, wind])
source scene sys.photo(query: state.mood, cond: now.cond)

source here sys.gps()
source found sys.search(query: state.query, count: 5, fields: [name, label, query, lat, lon])
source origin_place sys.search(query: state.origin, count: 1, fields: [id, name, lat, lon])
source dest_place   sys.search(query: state.dest,   count: 1, fields: [id, name, lat, lon])

source trip_here sys.route(from_lat: state.from_lat, from_lon: state.from_lon,
                           to_lat: dest_place.0.lat, to_lon: dest_place.0.lon,
                           mode: state.mode, fields: [duration, distance])
source trip sys.route(from_lat: origin_place.0.lat, from_lon: origin_place.0.lon,
                      to_lat:   dest_place.0.lat,   to_lon:   dest_place.0.lon,
                      mode: state.mode, fields: [duration, distance])

source step_here sys.step(from_lat: state.from_lat, from_lon: state.from_lon,
                          to_lat:   dest_place.0.lat, to_lon: dest_place.0.lon,
                          at_lat:   here.lat,         at_lon: here.lon,
                          fields: [instruction, remaining, eta])
source step sys.step(from_lat: origin_place.0.lat, from_lon: origin_place.0.lon,
                     to_lat:   dest_place.0.lat,   to_lon:   dest_place.0.lon,
                     at_lat:   here.lat,           at_lon:   here.lon,
                     fields: [instruction, remaining, eta])

source mode_pref sys.prefs(fields: [mode])
source work_pref sys.prefs(fields: [work])
source env.locale sys.locale()

state city  { shape: text, initial: "" }
state units { shape: enum[c, f], initial: env.locale.temp_unit }
state mood  { shape: text, initial: "city street commute morning, cinematic, muted" }

state origin { shape: text, initial: "" }
state dest   { shape: text, initial: "office" }
state query  { shape: text, initial: "" }
state from_lat { shape: number, initial: here.lat }
state from_lon { shape: number, initial: here.lon }
state screen { shape: enum[plan, drive], initial: .plan }
state mode   { shape: enum[drive, walk, bike], initial: mode_pref.mode }
state view   { shape: enum[tilted, flat], initial: .tilted }
state editing { shape: enum[none, origin, dest], initial: .none }
state work   { shape: text, initial: work_pref.work }

event toggle_units { units: cycle(.c, .f) }
event edit_origin { editing: set(.origin), query: clear }
event edit_dest   { editing: set(.dest), query: clear }
event set_origin  { origin: set($value), query: clear, editing: set(.none) }
event set_dest    { dest: set($value), query: set($value), editing: set(.none) }
event typing      { query: set($value) }
event choose_origin { origin: set($value), query: clear, editing: set(.none) }
event choose_dest   { dest: set($value), query: clear, editing: set(.none) }
event go          { screen: cycle(.plan, .drive) }
event pick_mode   { mode: set($value), mode_pref: set($value) }
event flip_view   { view: cycle(.tilted, .flat) }
event save_work   { work: set($value), work_pref: set($value) }

copy eyebrow  { class: vocabulary, en: "TODAY", zh: "今天" }
copy loading  { class: vocabulary, en: "Reading the conditions…", zh: "正在读取天气…" }
copy offline  { class: vocabulary, en: "Can't reach the forecast", zh: "无法获取天气" }
copy title    { class: vocabulary, en: "Commute", zh: "通勤" }
copy from     { class: vocabulary, en: "FROM", zh: "从" }
copy to       { class: vocabulary, en: "TO", zh: "到" }
copy cur_loc  { class: vocabulary, en: "Current location", zh: "当前位置" }
copy seeking  { class: vocabulary, en: "Finding a route…", zh: "正在查找路线…" }
copy onward   { class: vocabulary, en: "GO", zh: "出发" }
copy stop     { class: vocabulary, en: "End", zh: "结束" }
copy drive    { class: vocabulary, en: "Drive", zh: "驾车" }
copy walk     { class: vocabulary, en: "Walk", zh: "步行" }
copy bike     { class: vocabulary, en: "Bike", zh: "骑行" }
copy flat_lbl { class: vocabulary, en: "2D", zh: "2D" }
copy tilt_lbl { class: vocabulary, en: "3D", zh: "3D" }
copy work_lbl { class: vocabulary, en: "WORK", zh: "公司" }
copy save_work_lbl { class: vocabulary, en: "☆ WORK", zh: "☆ 公司" }

component Quick(label: text, val: text, act: event) {
  view Row(align: .center, gap: 10, on_tap: act, value: val) {
    TextCaption(text: label, width: .label)
    TextRow(text: val, width: .fill)
  }
}

component Hit(f: record, pick: event) {
  view Row(align: .center, gap: 10, on_tap: pick, value: f.query) {
    Col(gap: 2) {
      TextRow(text: f.name)
      TextCaption(text: f.label)
    }
  }
}

view root Photo(src: scene, pad: .page) {
  when now.$state == .pending { TextBody(text: copy.loading) }
  when now.$state == .failed  { TextBody(text: copy.offline) }
  current
  commute
}

view current Col(gap: 4) {
  TextCaption(text: copy.eyebrow)
  TextTitle(text: place.name, width: .fill)
  Row(align: .center, gap: 12, on_tap: toggle_units) {
    WeatherIcon(cond: now.cond, size: .hero)
    TextHero(value: now.temp, unit: units)
  }
}

view commute Col(gap: 8) {
  TextTitle(text: copy.title)
  when screen == .plan {
    Col(align: .center) {
      Row(align: .center, gap: 8, width: .fit) {
        Chip(text: copy.drive, on_tap: pick_mode, value: .drive, active: mode == .drive)
        Chip(text: copy.walk,  on_tap: pick_mode, value: .walk,  active: mode == .walk)
        Chip(text: copy.bike,  on_tap: pick_mode, value: .bike,  active: mode == .bike)
      }
    }
    Panel {
      when editing == .origin {
        Row(align: .center, gap: 10) {
          TextCaption(text: copy.from, width: .label)
          Field(text: query, placeholder: origin, on_commit: set_origin,
                on_change: typing, width: .fill)
        }
      }
      when editing != .origin {
        Row(align: .center, gap: 10, on_tap: edit_origin, value: "1") {
          TextCaption(text: copy.from, width: .label)
          when origin == "" { TextRow(text: copy.cur_loc, width: .fill) }
          when origin != "" { TextRow(text: origin, width: .fill) }
        }
      }
      Rule()
      when editing == .dest {
        Row(align: .center, gap: 10) {
          TextCaption(text: copy.to, width: .label)
          Field(text: query, placeholder: dest, on_commit: set_dest,
                on_change: typing, width: .fill)
        }
      }
      when editing != .dest {
        Row(align: .center, gap: 10, on_tap: edit_dest, value: "1") {
          TextCaption(text: copy.to, width: .label)
          TextRow(text: dest, width: .fill)
        }
      }
    }

    when editing == .origin {
      when query == "" {
        Panel {
          when work != "" { Quick(label: copy.work_lbl, val: work, act: choose_origin) }
          when origin != "" { Quick(label: copy.save_work_lbl, val: origin, act: save_work) }
        }
      }
      for f, i in found key f.label { Hit(f: f, pick: choose_origin) }
    }
    when editing == .dest {
      when query == "" {
        Panel {
          when work != "" { Quick(label: copy.work_lbl, val: work, act: choose_dest) }
          when dest != "" { Quick(label: copy.save_work_lbl, val: dest, act: save_work) }
        }
      }
      for f, i in found key f.label { Hit(f: f, pick: choose_dest) }
    }

    when dest != "" {
      when origin != "" {
        when trip.$state == .pending { TextBody(text: copy.seeking) }
        when trip.$state == .ready {
          Col(align: .center) {
            Row(align: .center, width: .fit) {
              Chip(text: copy.onward, on_tap: go, tone: .primary)
            }
          }
          Map(mode: .plan, from: origin_place, to: dest_place, zoom: 16, controls: .all, summary: trip)
        }
      }
      when origin == "" {
        when trip_here.$state == .pending { TextBody(text: copy.seeking) }
        when trip_here.$state == .ready {
          Col(align: .center) {
            Row(align: .center, width: .fit) {
              Chip(text: copy.onward, on_tap: go, tone: .primary)
            }
          }
          Map(mode: .plan, from_lat: from_lat, from_lon: from_lon, to: dest_place,
              zoom: 16, controls: .all)
        }
      }
    }
  }
  when screen == .drive {
    Panel(dock: .top) {
      when origin != "" { TextBody(text: step.instruction, width: .fill) }
      when origin == "" { TextBody(text: step_here.instruction, width: .fill) }
    }
    Panel(dock: .right) {
      when view == .tilted { Chip(text: copy.flat_lbl, on_tap: flip_view) }
      when view == .flat   { Chip(text: copy.tilt_lbl, on_tap: flip_view) }
    }
    Panel(dock: .bottom) {
      when origin != "" { TextHero(value: step.eta, unit: .duration) }
      when origin == "" { TextHero(value: step_here.eta, unit: .duration) }
      when origin != "" { TextCaption(value: step.remaining) }
      when origin == "" { TextCaption(value: step_here.remaining) }
      Reveal {
        Chip(text: copy.stop, on_tap: go, tone: .danger)
      }
    }
    when origin != "" {
      Map(mode: .drive, from: origin_place, to: dest_place, at: here,
          view: view, zoom: 15, controls: .all)
    }
    when origin == "" {
      Map(mode: .drive, from_lat: from_lat, from_lon: from_lon, to: dest_place,
          at: here, view: view, zoom: 15, controls: .all)
    }
  }
}
