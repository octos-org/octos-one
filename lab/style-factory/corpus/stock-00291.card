# level: L0
# model: stock

source quote sys.quote(ticker: "MSFT", fields: [name, last, change, pct, open, high, low, volume, mktcap, pe])
source env.locale sys.locale()

state selected { shape: text, initial: "MSFT" }
state range    { shape: enum[d1, w1, m1, m6, y1], initial: .d1 }

event back      { selected: clear }
event set_range { range: set($value) }

copy back_lbl { class: vocabulary, en: "‹ Back", zh: "‹ 返回" }
copy loading  { class: vocabulary, en: "Fetching the quote…", zh: "正在获取行情…" }
copy offline  { class: vocabulary, en: "Can't reach the market feed", zh: "无法获取行情" }
copy open     { class: vocabulary, en: "Open", zh: "开盘" }
copy high     { class: vocabulary, en: "High", zh: "最高" }
copy low      { class: vocabulary, en: "Low", zh: "最低" }
copy volume   { class: vocabulary, en: "Volume", zh: "成交量" }
copy mktcap   { class: vocabulary, en: "Mkt Cap", zh: "市值" }
copy pe       { class: vocabulary, en: "P/E", zh: "市盈率" }

view root Surface(pad: .page) {
  when selected == "" { list }
  when selected != "" { detail }
}

view list Col {
  TextTitle(text: "Top Movers")
}

view detail Col {
  Row(align: .center, gap: 8) {
    Row(align: .center, width: .fill, on_tap: back) { TextRow(text: copy.back_lbl) }
  }
  when quote.$state == .pending { TextBody(text: copy.loading) }
  when quote.$state == .failed  { TextBody(text: copy.offline) }
  header
  chart
  ranges
  stats
}

view header Col {
  TextCaption(text: quote.name)
  TextHero(value: quote.last, format: .money)
  Row(gap: 8) {
    TextStat(value: quote.change, format: .signed_money, tint: quote.change)
    TextStat(value: quote.pct, format: .signed_pct, tint: quote.change)
  }
}

view chart StockPlot(symbol: selected, range: range)

view ranges Row(gap: 6) {
  Chip(text: "1D", on_tap: set_range, value: .d1, active: range == .d1)
  Chip(text: "1W", on_tap: set_range, value: .w1, active: range == .w1)
  Chip(text: "1M", on_tap: set_range, value: .m1, active: range == .m1)
  Chip(text: "6M", on_tap: set_range, value: .m6, active: range == .m6)
  Chip(text: "1Y", on_tap: set_range, value: .y1, active: range == .y1)
}

view stats Grid(cols: 2) {
  Tile(label: copy.open, value: quote.open, format: .money)
  Tile(label: copy.high, value: quote.high, format: .money)
  Tile(label: copy.low, value: quote.low, format: .money)
  Tile(label: copy.volume, value: quote.volume, format: .compact)
  Tile(label: copy.mktcap, value: quote.mktcap, format: .compact)
  Tile(label: copy.pe, value: quote.pe, format: .ratio)
}
