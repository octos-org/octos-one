# level: L0
# model: casablanca-dashboard

source place sys.geocode(name: state.city)
source now   sys.weather(lat: place.lat, lon: place.lon,
                         fields: [temp, feels, cond, precip, wind, humidity, pressure, uv])
source week  sys.weather(lat: place.lat, lon: place.lon, days: 7,
                         fields: [dayname, hi, lo, cond],
                         aggregate: [min_lo, max_hi])
source sun   sys.daylight(lat: place.lat, lon: place.lon)
source moon  sys.moonphase()
source scene sys.photo(query: state.mood, cond: now.cond)
source parks sys.places(lat: place.lat, lon: place.lon, category: "park",
                        count: 4, fields: [id, name, distance])
source cafes sys.places(lat: place.lat, lon: place.lon, category: "cafe",
                        count: 4, fields: [id, name, distance])
source hits  sys.video(query: state.q, count: 8,
                        fields: [id, title, channel, length, views, age, thumb, embed])
source page  sys.link(fields: [url])
source env.locale sys.locale()

state city  { shape: text, initial: "Casablanca" }
state units { shape: enum[c, f], initial: env.locale.temp_unit }
state q     { shape: text, initial: "Casablanca travel" }
state mood  { shape: text, initial: "coastal city skyline at street level, cinematic, muted" }

event toggle_units { units: cycle(.c, .f) }
event play         { page: set($value) }

copy eyebrow   { class: vocabulary, en: "CASABLANCA", zh: "卡萨布兰卡" }
copy loading   { class: vocabulary, en: "Loading dashboard…", zh: "正在加载…" }
copy offline   { class: vocabulary, en: "Can't reach services", zh: "无法获取数据" }
copy feels     { class: vocabulary, en: "Feels like", zh: "体感" }
copy humidity  { class: vocabulary, en: "Humidity", zh: "湿度" }
copy wind      { class: vocabulary, en: "Wind", zh: "风速" }
copy pressure  { class: vocabulary, en: "Pressure", zh: "气压" }
copy uv        { class: vocabulary, en: "UV Index", zh: "紫外线" }
copy precip    { class: vocabulary, en: "Rain", zh: "降水概率" }
copy sunrise   { class: vocabulary, en: "Sunrise", zh: "日出" }
copy sunset    { class: vocabulary, en: "Sunset", zh: "日落" }
copy sky       { class: vocabulary, en: "Satellite", zh: "卫星云图" }
copy air       { class: vocabulary, en: "Air Quality", zh: "空气质量" }
copy nearby    { class: vocabulary, en: "NEARBY · GREEN & COFFEE", zh: "附近 · 公园与咖啡" }
copy park_why  { class: vocabulary, en: "away · quiet green space", zh: "距离 · 安静的绿地" }
copy cafe_why  { class: vocabulary, en: "away · somewhere to sit", zh: "距离 · 可以坐坐的地方" }
copy watch     { class: vocabulary, en: "WATCH", zh: "观看" }

component ForecastRow(item: record, unit: enum[c, f]) {
  view Row(align: .center) {
    TextRow(text: item.dayname, width: .day)
    WeatherIcon(cond: item.cond, size: .row)
    TextValue(value: item.lo, unit: unit)
    TempBar(lo: item.lo, hi: item.hi, min: week.min_lo, max: week.max_hi)
    TextValue(value: item.hi, unit: unit)
  }
}

view root Photo(src: scene, pad: .page) {
  when now.$state == .pending { TextBody(text: copy.loading) }
  when now.$state == .failed  { TextBody(text: copy.offline) }
  current
  forecast
  cloudfield
  airfield
  sunmoon
  details
  nearby_places
  videos
}

view current Col(align: .center) {
  TextCaption(text: copy.eyebrow)
  TextTitle(text: place.name, width: .fill)
  WeatherIcon(cond: now.cond, size: .hero)
  TextHero(value: now.temp, unit: units, on_tap: toggle_units)
  Row(gap: 8, width: .fit) {
    TextCaption(glyph: "≈", value: now.feels, unit: units)
  }
}

view forecast Panel {
  for d in week.days key d.dayname {
    ForecastRow(item: d, unit: units)
  }
}

view cloudfield Panel {
  TextCaption(text: copy.sky)
  Satellite(lat: place.lat, lon: place.lon)
}

view airfield Panel {
  TextCaption(text: copy.air)
  AqiContour(lat: place.lat, lon: place.lon, span: 1.6)
}

view sunmoon Panel {
  Row {
    Col { TextCaption(text: copy.sunrise) TextStat(value: sun.rise, format: .time) }
    SunArc(rise: sun.rise, set: sun.set, now: sun.now)
    Col { TextCaption(text: copy.sunset) TextStat(value: sun.set, format: .time) }
  }
  MoonPhase(phase: moon.phase, illum: moon.illumination)
}

view details Grid(cols: 2) {
  Tile(label: copy.feels, value: now.feels, unit: units)
  Tile(label: copy.humidity, value: now.humidity, unit: .pct)
  Tile(label: copy.wind, value: now.wind, unit: .speed)
  Tile(label: copy.pressure, value: now.pressure, unit: .pressure)
  Tile(label: copy.uv, value: now.uv)
  Tile(label: copy.precip, value: now.precip, unit: .pct)
}

view nearby_places Col {
  TextCaption(text: copy.nearby)
  when parks.$state == .pending { TextBody(text: copy.loading) }
  Panel {
    for p, i in parks key p.id {
      Row(align: .center, gap: 10) {
        TextRow(text: "🌳")
        Col(gap: 2) {
          TextRow(text: p.name)
          TextCaption(text: p.distance, suffix: copy.park_why)
        }
      }
      Rule()
    }
    for c, i in cafes key c.id {
      Row(align: .center, gap: 10) {
        TextRow(text: "☕")
        Col(gap: 2) {
          TextRow(text: c.name)
          TextCaption(text: c.distance, suffix: copy.cafe_why)
        }
      }
      Rule()
    }
  }
}

view videos Col {
  TextCaption(text: copy.watch)
  when hits.$state == .pending { TextBody(text: copy.loading) }
  when hits.$state == .failed  { TextBody(text: copy.offline) }
  for v, i in hits key v.id {
    Row(align: .center, gap: 10, on_tap: play, value: v.embed) {
      Thumb(src: v.thumb)
      Col(gap: 2, width: .fill) {
        TextRow(text: v.title, width: .fill)
        TextCaption(text: v.channel)
        TextCaption(text: v.length)
      }
    }
    Rule()
  }
}
