# level: L0
# model: nav

source here sys.gps()
source found sys.search(query: state.query, count: 5, fields: [name, label, query, lat, lon])
source origin_place sys.search(query: state.origin, count: 1, fields: [id, name, lat, lon])
source dest_place sys.search(query: state.dest, count: 1, fields: [id, name, lat, lon])
source trip_here sys.route(from_lat: state.from_lat, from_lon: state.from_lon,
                           to_lat: dest_place.0.lat, to_lon: dest_place.0.lon,
                           mode: state.mode, fields: [duration, distance])
source step_here sys.step(from_lat: state.from_lat, from_lon: state.from_lon,
                          to_lat: dest_place.0.lat, to_lon: dest_place.0.lon,
                          at_lat: here.lat, at_lon: here.lon,
                          fields: [instruction, remaining, eta])
source trip sys.route(from_lat: origin_place.0.lat, from_lon: origin_place.0.lon,
                      to_lat: dest_place.0.lat, to_lon: dest_place.0.lon,
                      mode: state.mode, fields: [duration, distance])
source step sys.step(from_lat: origin_place.0.lat, from_lon: origin_place.0.lon,
                     to_lat: dest_place.0.lat, to_lon: dest_place.0.lon,
                     at_lat: here.lat, at_lon: here.lon,
                     fields: [instruction, remaining, eta])
source mode_pref sys.prefs(fields: [mode])
source env.locale sys.locale()

state origin { shape: text, initial: "" }
state from_lat { shape: number, initial: here.lat }
state from_lon { shape: number, initial: here.lon }
state dest { shape: text, initial: "coffee shop" }
state query { shape: text, initial: "" }
state screen { shape: enum[plan, drive], initial: .plan }
state mode { shape: enum[drive, walk, bike], initial: mode_pref.mode }
state editing { shape: enum[none, origin, dest], initial: .none }

event edit_origin { editing: set(.origin), query: clear }
event edit_dest { editing: set(.dest), query: clear }
event set_origin { origin: set($value), query: clear, editing: set(.none) }
event set_dest { dest: set($value), query: set($value), editing: set(.none) }
event typing { query: set($value) }
event choose_origin { origin: set($value), query: clear, editing: set(.none) }
event choose_dest { dest: set($value), query: clear, editing: set(.none) }
event go { screen: cycle(.plan, .drive) }
event pick_mode { mode: set($value), mode_pref: set($value) }

copy title { class: vocabulary, en: "Directions" }
copy from { class: vocabulary, en: "FROM" }
copy to { class: vocabulary, en: "TO" }
copy cur_loc { class: vocabulary, en: "Current location", zh: "当前位置" }
copy seeking { class: vocabulary, en: "Finding a route…" }
copy onward { class: vocabulary, en: "GO" }
copy stop { class: vocabulary, en: "End" }
copy drive { class: vocabulary, en: "Drive" }
copy walk { class: vocabulary, en: "Walk" }
copy bike { class: vocabulary, en: "Bike" }
copy left { class: vocabulary, en: "left" }

view root Surface {
  when screen == .plan {
    TextTitle(text: copy.title)
    Col(align: .center) {
      Row(align: .center, gap: 8, width: .fit) {
        Chip(text: copy.drive, on_tap: pick_mode, value: .drive, active: mode == .drive)
        Chip(text: copy.walk, on_tap: pick_mode, value: .walk, active: mode == .walk)
        Chip(text: copy.bike, on_tap: pick_mode, value: .bike, active: mode == .bike)
      }
    }
    Panel {
      when editing == .origin {
        Row(align: .center, gap: 10) {
          TextCaption(text: copy.from, width: .label)
          Field(text: query, placeholder: origin, on_commit: set_origin, on_change: typing, width: .fill)
        }
      }
      when editing != .origin {
        Row(align: .center, gap: 10, on_tap: edit_origin, value: "1") {
          TextCaption(text: copy.from, width: .label)
          when origin == "" { TextRow(text: copy.cur_loc, width: .fill) }
          when origin != "" { TextRow(text: origin, width: .fill) }
        }
      }
      Rule()
      when editing == .dest {
        Row(align: .center, gap: 10) {
          TextCaption(text: copy.to, width: .label)
          Field(text: query, placeholder: dest, on_commit: set_dest, on_change: typing, width: .fill)
        }
      }
      when editing != .dest {
        Row(align: .center, gap: 10, on_tap: edit_dest, value: "1") {
          TextCaption(text: copy.to, width: .label)
          TextRow(text: dest, width: .fill)
        }
      }
    }
    when editing == .origin {
      for f, i in found key f.label {
        Row(align: .center, gap: 10, on_tap: choose_origin, value: f.query) {
          Col(gap: 2) {
            TextRow(text: f.name)
            TextCaption(text: f.label)
          }
        }
      }
    }
    when editing == .dest {
      for f, i in found key f.label {
        Row(align: .center, gap: 10, on_tap: choose_dest, value: f.query) {
          Col(gap: 2) {
            TextRow(text: f.name)
            TextCaption(text: f.label)
          }
        }
      }
    }
    when dest != "" {
      when origin != "" {
        when trip.$state == .pending { TextBody(text: copy.seeking) }
        when trip.$state == .ready {
          Col(align: .center) {
            Row(align: .center, width: .fit) {
              Chip(text: copy.onward, on_tap: go, tone: .primary)
            }
          }
          Map(mode: .plan, from: origin_place, to: dest_place, zoom: 16)
        }
      }
      when origin == "" {
        when trip_here.$state == .pending { TextBody(text: copy.seeking) }
        when trip_here.$state == .ready {
          Col(align: .center) {
            Row(align: .center, width: .fit) {
              Chip(text: copy.onward, on_tap: go, tone: .primary)
            }
          }
          Map(mode: .plan, from_lat: from_lat, from_lon: from_lon, to: dest_place, zoom: 16)
        }
      }
    }
  }
  when screen == .drive {
    Panel(dock: .top) {
      when origin != "" { TextBody(text: step.instruction, width: .fill) }
      when origin == "" { TextBody(text: step_here.instruction, width: .fill) }
    }
    Panel(dock: .bottom) {
      when origin != "" { TextHero(value: step.eta, unit: .duration) }
      when origin == "" { TextHero(value: step_here.eta, unit: .duration) }
      when origin != "" { TextCaption(value: step.remaining) }
      when origin == "" { TextCaption(value: step_here.remaining) }
      Chip(text: copy.stop, on_tap: go, tone: .danger)
    }
    when origin != "" {
      Map(mode: .drive, from: origin_place, to: dest_place, at: here, zoom: 15)
    }
    when origin == "" {
      Map(mode: .drive, from_lat: from_lat, from_lon: from_lon, to: dest_place, at: here, zoom: 15)
    }
  }
}
