# level: L0
# model: weather-activity

source place sys.geocode(name: state.city)
source now   sys.weather(lat: place.lat, lon: place.lon,
                         fields: [temp, feels, cond, precip, wind])
source air   sys.airquality(lat: place.lat, lon: place.lon)
source parks sys.places(lat: place.lat, lon: place.lon, category: "park",
                        count: 3, fields: [id, name, distance])
source cafes sys.places(lat: place.lat, lon: place.lon, category: "cafe",
                        count: 3, fields: [id, name, distance])
source hits  sys.video(query: state.q, count: 6,
                       fields: [id, title, channel, length, views, age, thumb, embed])
source page  sys.link(fields: [url])
source env.locale sys.locale()

state city  { shape: text, initial: "Turin" }
state units { shape: enum[c, f], initial: env.locale.temp_unit }
state q     { shape: text, initial: "Turin travel" }
state typed { shape: text, initial: "" }
state editing { shape: enum[none, find], initial: .none }

event toggle_units { units: cycle(.c, .f) }
event open_find { editing: set(.find), typed: clear }
event typing    { typed: set($value) }
event run_find  { q: set($value), typed: clear, editing: set(.none) }
event close_find { editing: set(.none), typed: clear }
event play      { page: set($value) }

copy eyebrow  { class: vocabulary, en: "TURIN DASHBOARD", zh: "都灵仪表盘" }
copy loading  { class: vocabulary, en: "Loading dashboard…", zh: "正在加载…" }
copy offline  { class: vocabulary, en: "Can't reach services", zh: "无法获取数据" }
copy go_out   { class: vocabulary, en: "Good day to be outside", zh: "适合外出" }
copy stay_in  { class: vocabulary, en: "Better indoors today", zh: "今天更适合室内" }
copy why_wet  { class: vocabulary, en: "rain is likely", zh: "可能有雨" }
copy why_air  { class: vocabulary, en: "the air is poor", zh: "空气质量差" }
copy why_cold { class: vocabulary, en: "it is cold out", zh: "天气偏冷" }
copy why_fine { class: vocabulary, en: "mild, dry and clear", zh: "温和、干燥、空气好" }
copy aqi_lbl  { class: vocabulary, en: "AIR", zh: "空气" }
copy rain_lbl { class: vocabulary, en: "RAIN", zh: "降水" }
copy nearby   { class: vocabulary, en: "NEARBY", zh: "附近" }
copy park_why { class: vocabulary, en: "away · green space" }
copy cafe_why { class: vocabulary, en: "away · coffee" }
copy videos   { class: vocabulary, en: "TRAVEL VIDEOS", zh: "旅行视频" }
copy find_lbl { class: vocabulary, en: "Search", zh: "搜索" }

component Pick(hit: record) {
  view Col(gap: 2, width: .fill) {
         TextRow(text: hit.name)
         TextCaption(text: hit.label)
       }
}

view root Surface(pad: .page) {
  when now.$state == .pending { TextBody(text: copy.loading) }
  when now.$state == .failed  { TextBody(text: copy.offline) }
  current
  verdict
  nearby_places
  video_section
}

view current Col(gap: 4) {
  TextCaption(text: copy.eyebrow)
  TextTitle(text: place.name, width: .fill)
  Row(align: .center, gap: 12, on_tap: toggle_units) {
    WeatherIcon(cond: now.cond, size: .hero)
    TextHero(value: now.temp, unit: units)
  }
  Row(gap: 14) {
    Tile(label: copy.rain_lbl, value: now.precip, unit: .pct)
    Tile(label: copy.aqi_lbl, value: air.aqi)
  }
}

view verdict Col(gap: 10) {
  when now.precip >= 40 { wet }
  when now.precip < 40 {
    when air.aqi >= 100 { smoggy }
    when air.aqi < 100 {
      when now.temp < 12 { cold }
      when now.temp >= 12 { fine }
    }
  }
}

view wet    Col(gap: 10) { TextTitle(text: copy.stay_in) TextBody(text: copy.why_wet) }
view smoggy Col(gap: 10) { TextTitle(text: copy.stay_in) TextBody(text: copy.why_air) }
view cold   Col(gap: 10) { TextTitle(text: copy.stay_in) TextBody(text: copy.why_cold) }
view fine   Col(gap: 10) { TextTitle(text: copy.go_out) TextBody(text: copy.why_fine) }

view nearby_places Col(gap: 8) {
  TextCaption(text: copy.nearby)
  Panel {
    when parks.$state == .pending { TextBody(text: copy.loading) }
    for p, i in parks key p.id {
      Row(align: .center, gap: 10) {
        TextRow(text: "🌳")
        Col(gap: 2) {
          TextRow(text: p.name)
          TextCaption(text: p.distance, suffix: copy.park_why)
        }
      }
      Rule()
    }
    for c, i in cafes key c.id {
      Row(align: .center, gap: 10) {
        TextRow(text: "☕")
        Col(gap: 2) {
          TextRow(text: c.name)
          TextCaption(text: c.distance, suffix: copy.cafe_why)
        }
      }
      Rule()
    }
  }
}

view video_section Col(gap: 8) {
  Row(align: .center, gap: 8) {
    TextCaption(text: copy.videos, width: .fill)
    Chip(text: copy.find_lbl, on_tap: open_find, value: "1")
  }
  TextTitle(text: q, width: .fill)
  when editing == .find {
    Panel {
      Row(align: .center, gap: 10) {
        Field(text: typed, placeholder: q, on_commit: run_find,
              on_change: typing, width: .fill)
        Chip(text: "×", on_tap: close_find)
      }
    }
  }
  when hits.$state == .pending { TextBody(text: copy.loading) }
  when hits.$state == .failed  { TextBody(text: copy.offline) }
  for v, i in hits key v.id {
    Row(align: .center, gap: 10, on_tap: play, value: v.embed) {
      Thumb(src: v.thumb)
      Col(gap: 2, width: .fill) {
        TextRow(text: v.title, width: .fill)
        TextCaption(text: v.channel)
        TextCaption(text: v.length)
      }
    }
    Rule()
  }
}
