# level: L0
# model: foodie-paris

source place sys.geocode(name: state.city)
source restaurants sys.places(lat: place.lat, lon: place.lon, category: "cafe", count: 5, fields: [id, name, distance])
source hits sys.video(query: state.q, count: 8, fields: [id, title, channel, length, views, age, thumb, embed])
source page sys.link(fields: [url])
source env.locale sys.locale()

state city { shape: text, initial: "Paris" }
state q { shape: text, initial: "Paris food tour" }
state typed { shape: text, initial: "" }
state editing { shape: enum[none, find], initial: .none }

event open_find { editing: set(.find), typed: clear }
event typing { typed: set($value) }
event run_find { q: set($value), typed: clear, editing: set(.none) }
event close_find { editing: set(.none), typed: clear }
event play { page: set($value) }

copy eyebrow { class: vocabulary, en: "PARIS FOODIE", zh: "巴黎美食" }
copy heading { class: vocabulary, en: "Eat & Watch", zh: "吃与看" }
copy loading { class: vocabulary, en: "Finding food…", zh: "正在查找美食…" }
copy offline { class: vocabulary, en: "Can't reach the data", zh: "无法获取数据" }
copy nearby { class: vocabulary, en: "NEARBY SPOTS", zh: "附近" }
copy videos { class: vocabulary, en: "FOOD VIDEOS", zh: "美食视频" }
copy search { class: vocabulary, en: "Search", zh: "搜索" }
copy away { class: vocabulary, en: "away", zh: "距离" }

view root Surface(pad: .page) {
  Col(gap: 8) {
    TextCaption(text: copy.eyebrow)
    TextTitle(text: copy.heading, width: .fill)

    when restaurants.$state == .pending { TextBody(text: copy.loading) }
    when restaurants.$state == .failed { TextBody(text: copy.offline) }

    nearby_panel
    videos_section
  }
}

view nearby_panel Panel {
  TextCaption(text: copy.nearby)
  for r, i in restaurants key r.id {
    Row(align: .center, gap: 10) {
      TextRow(text: "🍽️")
      Col(gap: 2) {
        TextRow(text: r.name)
        TextCaption(text: r.distance, suffix: copy.away)
      }
    }
    Rule()
  }
}

view videos_section Col(gap: 6) {
  Row(align: .center, gap: 8) {
    TextCaption(text: copy.videos, width: .fill)
    Chip(text: copy.search, on_tap: open_find, value: "1")
  }
  TextTitle(text: q, width: .fill)

  when editing == .find {
    Panel {
      Row(align: .center, gap: 10) {
        Field(text: typed, placeholder: q, on_commit: run_find, on_change: typing, width: .fill)
        Chip(text: "×", on_tap: close_find)
      }
    }
  }

  when hits.$state == .pending { TextBody(text: copy.loading) }
  when hits.$state == .failed { TextBody(text: copy.offline) }

  for v, i in hits key v.id {
    Row(align: .center, gap: 10, on_tap: play, value: v.embed) {
      Thumb(src: v.thumb)
      Col(gap: 2, width: .fill) {
        TextRow(text: v.title, width: .fill)
        TextCaption(text: v.channel)
        TextCaption(text: v.length)
      }
    }
    Rule()
  }
}
