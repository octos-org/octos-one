# level: L0
# model: foodie-naples

source place  sys.geocode(name: state.city)
source scene  sys.photo(query: state.mood, cond: now.cond)
source now    sys.weather(lat: place.lat, lon: place.lon, fields: [cond])

source rest1  sys.search(query: "Pizzeria da Michele Naples", count: 1, fields: [name, label])
source rest2  sys.search(query: "Sorbillo Naples", count: 1, fields: [name, label])
source rest3  sys.search(query: "L'Antica Pizzeria Port'Alba Naples", count: 1, fields: [name, label])
source rest4  sys.search(query: "Spaccanapoli Naples", count: 1, fields: [name, label])
source rest5  sys.search(query: "Mergellina Naples", count: 1, fields: [name, label])
source rest6  sys.search(query: "Piazza del Plebiscito Naples", count: 1, fields: [name, label])

source hits   sys.video(query: state.q, count: 12, fields: [id, title, channel, length, views, age, thumb, embed])
source page   sys.link(fields: [url])
source env.locale sys.locale()

state city  { shape: text, initial: "Naples" }
state mood  { shape: text, initial: "mediterranean street food market, warm light, cinematic" }
state q     { shape: text, initial: "Naples food tour" }
state typed { shape: text, initial: "" }
state editing { shape: enum[none, find], initial: .none }

event open_find  { editing: set(.find), typed: clear }
event typing     { typed: set($value) }
event run_find   { q: set($value), typed: clear, editing: set(.none) }
event close_find { editing: set(.none), typed: clear }
event play       { page: set($value) }

copy eyebrow  { class: vocabulary, en: "NAPLES FOODIE", zh: "那不勒斯美食" }
copy title    { class: vocabulary, en: "Eat Like a Local", zh: "像当地人一样吃" }
copy places   { class: vocabulary, en: "WHERE TO EAT", zh: "去哪吃" }
copy videos   { class: vocabulary, en: "WATCH", zh: "观看" }
copy find_lbl { class: vocabulary, en: "Search", zh: "搜索" }
copy loading  { class: vocabulary, en: "Loading…", zh: "加载中…" }
copy offline  { class: vocabulary, en: "Can't reach the service", zh: "无法连接" }

component Pick(hit: record) {
  view Col(gap: 2, width: .fill) {
    TextRow(text: hit.name)
    TextCaption(text: hit.label)
  }
}

view root Photo(src: scene, pad: .page) {
  when now.$state == .pending { TextBody(text: copy.loading) }
  when now.$state == .failed  { TextBody(text: copy.offline) }
  header
  places_panel
  videos_panel
}

view header Col(gap: 4) {
  TextCaption(text: copy.eyebrow)
  TextTitle(text: copy.title, width: .fill)
}

view places_panel Panel {
  TextCaption(text: copy.places)
  when rest1.$state == .pending { TextBody(text: copy.loading) }
  for h, i in rest1 key h.label { Pick(hit: h) Rule() }
  for h, i in rest2 key h.label { Pick(hit: h) Rule() }
  for h, i in rest3 key h.label { Pick(hit: h) Rule() }
  for h, i in rest4 key h.label { Pick(hit: h) Rule() }
  for h, i in rest5 key h.label { Pick(hit: h) Rule() }
  for h, i in rest6 key h.label { Pick(hit: h) Rule() }
}

view videos_panel Col {
  Row(align: .center, gap: 8) {
    TextCaption(text: copy.videos, width: .fill)
    Chip(text: copy.find_lbl, on_tap: open_find, value: "1")
  }
  TextTitle(text: q, width: .fill)
  finder
  when hits.$state == .pending { TextBody(text: copy.loading) }
  when hits.$state == .failed  { TextBody(text: copy.offline) }
  results
}

view finder Col {
  when editing == .find {
    Panel {
      Row(align: .center, gap: 10) {
        Field(text: typed, placeholder: q, on_commit: run_find, on_change: typing, width: .fill)
        Chip(text: "×", on_tap: close_find)
      }
    }
  }
}

view results Col {
  for v, i in hits key v.id {
    Row(align: .center, gap: 10, on_tap: play, value: v.embed) {
      Thumb(src: v.thumb)
      Col(gap: 2, width: .fill) {
        TextRow(text: v.title, width: .fill)
        TextCaption(text: v.channel)
        TextCaption(text: v.length)
      }
    }
    Rule()
  }
}
