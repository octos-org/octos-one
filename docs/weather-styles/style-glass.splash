SolidView{ width: Fill height: 1400 flow: Overlay new_batch: true draw_bg.color: #2a3d66
    GradientYView{ width: Fill height: Fill new_batch: true draw_bg.color: #3a7bd5 draw_bg.color_2: #3a1c71 }
    View{ width: Fill height: Fill flow: Down padding: Inset{left: 16 top: 56 right: 16 bottom: 20} spacing: 14
        View{ width: Fill height: Fit flow: Down align: Align{x: 0.5} spacing: 0
            Label{ text: "Tokyo" draw_text.color: #ffffff draw_text.text_style: TextStyle{ font_family: FontFamily{ latin := FontMember{ res: crate_resource("makepad_widgets:resources/Roboto-Regular.ttf") asc: 0.0 desc: 0.0 } } font_size: 24 } }
            Label{ text: sys.weather(35.68, 139.65, "current.temperature_2m") + "°" draw_text.color: #ffffff draw_text.text_style: TextStyle{ font_family: FontFamily{ latin := FontMember{ res: crate_resource("makepad_widgets:resources/Roboto-Thin.ttf") asc: 0.0 desc: 0.0 } } font_size: 88 } margin: Inset{top: 2 bottom: 0} }
            View{ width: Fit height: 34 flow: Right align: Align{y: 0.5} spacing: 8
                WeatherIcon{ draw_bg.cond: 1.0 width: 30 height: 30 }
                Label{ text: "Partly Cloudy" draw_text.color: #ffffffee draw_text.text_style: TextStyle{ font_family: FontFamily{ latin := FontMember{ res: crate_resource("makepad_widgets:resources/Roboto-Medium.ttf") asc: 0.0 desc: 0.0 } } font_size: 16 } }
            }
            Label{ text: "H:" + sys.weather(35.68, 139.65, "daily.temperature_2m_max.0") + "°   L:" + sys.weather(35.68, 139.65, "daily.temperature_2m_min.0") + "°" draw_text.color: #ffffffcc draw_text.text_style.font_size: 14 margin: Inset{top: 3} }
        }
        RoundedView{ width: Fill height: Fit flow: Right new_batch: true padding: Inset{left: 8 top: 12 right: 8 bottom: 12} draw_bg.color: #ffffff26 draw_bg.border_radius: 20.0
            View{ width: Fill height: Fit flow: Down align: Align{x: 0.5} spacing: 3
                Label{ text: "FEELS" draw_text.color: #ffffffaa draw_text.text_style.font_size: 10 }
                Label{ text: sys.weather(35.68, 139.65, "current.apparent_temperature") + "°" draw_text.color: #ffffff draw_text.text_style: TextStyle{ font_family: FontFamily{ latin := FontMember{ res: crate_resource("makepad_widgets:resources/Roboto-Medium.ttf") asc: 0.0 desc: 0.0 } } font_size: 19 } }
            }
            View{ width: Fill height: Fit flow: Down align: Align{x: 0.5} spacing: 3
                Label{ text: "HUMIDITY" draw_text.color: #ffffffaa draw_text.text_style.font_size: 10 }
                Label{ text: sys.weather(35.68, 139.65, "current.relative_humidity_2m") + "%" draw_text.color: #ffffff draw_text.text_style: TextStyle{ font_family: FontFamily{ latin := FontMember{ res: crate_resource("makepad_widgets:resources/Roboto-Medium.ttf") asc: 0.0 desc: 0.0 } } font_size: 19 } }
            }
            View{ width: Fill height: Fit flow: Down align: Align{x: 0.5} spacing: 3
                Label{ text: "WIND" draw_text.color: #ffffffaa draw_text.text_style.font_size: 10 }
                Label{ text: sys.weather(35.68, 139.65, "current.wind_speed_10m") draw_text.color: #ffffff draw_text.text_style: TextStyle{ font_family: FontFamily{ latin := FontMember{ res: crate_resource("makepad_widgets:resources/Roboto-Medium.ttf") asc: 0.0 desc: 0.0 } } font_size: 19 } }
            }
            View{ width: Fill height: Fit flow: Down align: Align{x: 0.5} spacing: 3
                Label{ text: "UV" draw_text.color: #ffffffaa draw_text.text_style.font_size: 10 }
                Label{ text: sys.weather(35.68, 139.65, "daily.uv_index_max.0") draw_text.color: #ffffff draw_text.text_style: TextStyle{ font_family: FontFamily{ latin := FontMember{ res: crate_resource("makepad_widgets:resources/Roboto-Medium.ttf") asc: 0.0 desc: 0.0 } } font_size: 19 } }
            }
        }
        RoundedView{ width: Fill height: Fit flow: Down new_batch: true padding: Inset{left: 10 top: 10 right: 10 bottom: 12} draw_bg.color: #ffffff26 draw_bg.border_radius: 20.0 spacing: 8
            Label{ text: "7-DAY FORECAST" draw_text.color: #ffffffaa draw_text.text_style.font_size: 10 margin: Inset{left: 4 top: 2} }
            View{ width: Fill height: Fit flow: Right spacing: 4
                View{ width: Fill height: Fit flow: Down align: Align{x: 0.5} spacing: 6
                    Label{ text: "Today" draw_text.color: #ffffffcc draw_text.text_style.font_size: 11 }
                    WeatherIcon{ draw_bg.cond: 1.0 width: 28 height: 28 }
                    Label{ text: sys.weather(35.68, 139.65, "daily.temperature_2m_max.0") + "°" draw_text.color: #ffffff draw_text.text_style.font_size: 13 }
                    Label{ text: sys.weather(35.68, 139.65, "daily.temperature_2m_min.0") + "°" draw_text.color: #ffffff99 draw_text.text_style.font_size: 12 }
                }
                View{ width: Fill height: Fit flow: Down align: Align{x: 0.5} spacing: 6
                    Label{ text: "Sun" draw_text.color: #ffffffcc draw_text.text_style.font_size: 11 }
                    WeatherIcon{ draw_bg.cond: 0.0 width: 28 height: 28 }
                    Label{ text: sys.weather(35.68, 139.65, "daily.temperature_2m_max.1") + "°" draw_text.color: #ffffff draw_text.text_style.font_size: 13 }
                    Label{ text: sys.weather(35.68, 139.65, "daily.temperature_2m_min.1") + "°" draw_text.color: #ffffff99 draw_text.text_style.font_size: 12 }
                }
                View{ width: Fill height: Fit flow: Down align: Align{x: 0.5} spacing: 6
                    Label{ text: "Mon" draw_text.color: #ffffffcc draw_text.text_style.font_size: 11 }
                    WeatherIcon{ draw_bg.cond: 0.0 width: 28 height: 28 }
                    Label{ text: sys.weather(35.68, 139.65, "daily.temperature_2m_max.2") + "°" draw_text.color: #ffffff draw_text.text_style.font_size: 13 }
                    Label{ text: sys.weather(35.68, 139.65, "daily.temperature_2m_min.2") + "°" draw_text.color: #ffffff99 draw_text.text_style.font_size: 12 }
                }
                View{ width: Fill height: Fit flow: Down align: Align{x: 0.5} spacing: 6
                    Label{ text: "Tue" draw_text.color: #ffffffcc draw_text.text_style.font_size: 11 }
                    WeatherIcon{ draw_bg.cond: 4.0 width: 28 height: 28 }
                    Label{ text: sys.weather(35.68, 139.65, "daily.temperature_2m_max.3") + "°" draw_text.color: #ffffff draw_text.text_style.font_size: 13 }
                    Label{ text: sys.weather(35.68, 139.65, "daily.temperature_2m_min.3") + "°" draw_text.color: #ffffff99 draw_text.text_style.font_size: 12 }
                }
                View{ width: Fill height: Fit flow: Down align: Align{x: 0.5} spacing: 6
                    Label{ text: "Wed" draw_text.color: #ffffffcc draw_text.text_style.font_size: 11 }
                    WeatherIcon{ draw_bg.cond: 2.0 width: 28 height: 28 }
                    Label{ text: sys.weather(35.68, 139.65, "daily.temperature_2m_max.4") + "°" draw_text.color: #ffffff draw_text.text_style.font_size: 13 }
                    Label{ text: sys.weather(35.68, 139.65, "daily.temperature_2m_min.4") + "°" draw_text.color: #ffffff99 draw_text.text_style.font_size: 12 }
                }
            }
        }
    }
}
